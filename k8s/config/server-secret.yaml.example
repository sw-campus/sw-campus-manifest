apiVersion: v1
kind: Secret
metadata:
  name: sw-campus-server-secret
  namespace: default
type: Opaque
stringData:
  # 실제 값은 로컬에서만 설정하고 GitHub에 올리지 마세요!
  # kubectl create secret generic sw-campus-server-secret \
  #   --from-literal=SPRING_DATASOURCE_PASSWORD='your-actual-password' \
  #   --from-literal=JWT_SECRET='your-actual-jwt-secret' \
  #   --dry-run=client -o yaml > server-secret.yaml
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME"
  # JWT_SECRET: "CHANGE_ME"
  # AWS_ACCESS_KEY_ID: "CHANGE_ME"
  # AWS_SECRET_ACCESS_KEY: "CHANGE_ME"

